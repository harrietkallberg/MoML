# Install and load necessary packages
install.packages("mvtnorm")
library(mvtnorm)
# Definieren der Parameter der Normalverteilung
mu <- c(1, 3, 3)
Sigma <- matrix(c(3.00, -1.29, 0.46, -1.29, 5.00, 1.14, 0.46, 1.14, 4.00), nrow = 3, ncol = 3)
# Definieren des Intervalls
lower <- c(2, 3, -Inf)
upper <- c(Inf, 100, 50)
# Berechnen der Wahrscheinlichkeit
probability <- 1 - pmvnorm(lower = c(-Inf, 3, -Inf), upper = c(2, 100, 50), mean = mu, sigma = Sigma)
rounded_probability <- round(probability, 4)
# Ausgabe des Ergebnisses
cat("Die approximierte Wahrscheinlichkeit ist:", rounded_probability, "\n")
